# Pi Web Dockerized User Configuration
#
# This file is generated by setup.sh but can be edited manually.
# Location: ~/.config/pi-web-dockerized/config
#
# Format:
#   setting.<name>=<value>                              # Settings
#   package.<name>=<npm:... | git:...>                  # Pi packages
#   mount.<name>=<host_path>:<container_path>[:<mode>]  # Volume mounts
#   env.<name>=<VARIABLE_NAME>                          # Environment variables
#
# Modes: "ro" (read-only, default) or "rw" (read-write)
# Paths: Use ~ for home directory (expanded at runtime)
# Vars:  Must be uppercase with underscores, set in host environment

# ============================================
# Settings
# ============================================

# SSH Agent Forwarding
# Mounts the SSH_AUTH_SOCK socket and passes the variable, so git over SSH works in
# the container without sharing any key.
# setting.ssh_agent_support=true

# Graphify: per-project code knowledge graph (default: true)
# Installs the graphify-pi package and, for 'run' and 'exec', builds graphify-out/ in
# the project on launch and refreshes it incrementally afterwards.
# setting.graphify_support=false

# PlantUML server for 'pumlcli' (default: true)
# setting.plantuml_support=false

# Share the host's ~/.pi/agent with the container (default: false).
# Not recommended: the container then reads your credentials and may modify your
# extensions. The default is a private directory under
# ~/.local/share/pi-web-dockerized/agent.
# setting.host_pi_config=true

# pi-web browser UI ('pi-web-dockerized.sh web'); no authentication, keep it on loopback
# setting.web_host=127.0.0.1
# setting.web_port=8504

# ============================================
# Pi packages: skills, agents, extensions, prompts
# ============================================
# Installed on first launch into the agent directory. Pin a version for
# reproducibility: npm:pi-matt-pocock-skills@0.2.0
# Browse: https://pi.dev/packages
#
package.matt_pocock_skills=npm:pi-matt-pocock-skills
# package.web_access=npm:pi-web-access

# ============================================
# Custom Volume Mounts
# ============================================
# Mounts are read-only by default. Append :rw for read-write access.
# mount.gitconfig=~/.gitconfig:/home/coder/.gitconfig

# ============================================
# Environment Variables
# ============================================
# Passed from your host environment to the container when set. Alternative to /login.
# env.anthropic=ANTHROPIC_API_KEY
# env.openai=OPENAI_API_KEY
# env.aws_bedrock=AWS_BEARER_TOKEN_BEDROCK
